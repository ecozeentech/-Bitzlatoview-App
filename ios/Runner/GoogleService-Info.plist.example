<?xml version="1.0" encoding="UTF-8"?>
<!-- Template only. Download your real GoogleService-Info.plist from the
     Firebase console (Project settings > Your apps > iOS app) and save it
     as ios/Runner/GoogleService-Info.plist (git-ignored), then drag it into
     the Runner target in Xcode so it's copied into the app bundle. Bundle
     ID must be com.bitzlatoview.bitzlatoviewMobile. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REPLACE_WITH_REAL_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.bitzlatoview.bitzlatoviewMobile</string>
	<key>PROJECT_ID</key>
	<string>bitzlatoview-mobile</string>
	<key>STORAGE_BUCKET</key>
	<string>bitzlatoview-mobile.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<false/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# ---------------------------------------------------------------------------
# Bitzlatoview: secrets & machine-generated files that must never be committed
# ---------------------------------------------------------------------------

# Firebase project config (contains project-specific identifiers/keys) -
# see README "Firebase setup" for how to add your own locally / in CI.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Android release signing
android/key.properties
android/app/*.jks
android/app/*.keystore
*.keystore
*.jks

# iOS signing / provisioning
ios/Runner/Runner.entitlements.local
*.mobileprovision
*.p12
*.p8

# CocoaPods (regenerated by `pod install`)
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# Local environment overrides
.env
.env.*

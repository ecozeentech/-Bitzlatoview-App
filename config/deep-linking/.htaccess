# Host on Apache / Hostinger – place in public/.well-known/
# Ensures correct MIME type and no redirects for Universal Links / App Links.

<IfModule mod_headers.c>
  Header set Content-Type "application/json"
  Header set Access-Control-Allow-Origin "*"
</IfModule>

<Files "apple-app-site-association">
  Header set Content-Type "application/json"
</Files>
